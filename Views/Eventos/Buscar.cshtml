@using Exercicios_ASPNET_MVC.ViewModels

@model BuscaEventoViewModel
@{
    ViewData["Title"] = "Buscar evento";
}

<h1>Buscar Eventos</h1>

<form asp-action="Buscar" method="post">
    <input asp-for="NomeBusca" placeholder="Nome do evento" />
    <button type="submit">Buscar</button>
</form>

@if (Model.Resultados != null)
{
    if (Model.Resultados.Count == 0)
    {
        <p>Nenhum item foi encontrado.</p>
    }
    else
    {
        <table>
            <tr>
                <th>Nome</th>
                <th>Local</th>
                <th>Data do Evento</th>
                <th>Quantidade de vagas</th>
                <th>Valor do Ingresso</th>
            </tr>

            @foreach (Evento evento in Model.Resultados)
            {
                <tr>
                    <td>@evento.Nome</td>
                    <td>@evento.Local</td>
                    <td>@evento.DataEvento.ToString("dd/MM/yyyy")</td>
                    <td>@evento.QuantidadeVagas</td>
                    <td>@evento.ValorIngresso.ToString("C")</td>
                </tr>
            }
        </table>
    }
}